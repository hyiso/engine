action("ohos_har") {
  script = "//build/ohos/create_flutter_har.py"

  if (stripped_symbols) {
    engine_library = "libflutter.so"
  } else {
    engine_library = "so.unstripped/libflutter.so"
  }

  sources = ohos_arkts_sources

  inputs = [ "$root_build_dir/$engine_library" ]

  outputs = [ "$root_build_dir/flutter.har" ]

  args = [
           "--build_dir",
           "./obj/ohos",
           "--build_type",
           flutter_runtime_mode,
           "--output",
           rebase_path("flutter.har", root_build_dir, root_build_dir),
           "--native_lib",
           rebase_path("$engine_library", root_build_dir, root_build_dir),
           "--ohos_abi",
           ohos_app_abi,
           "--source_dir",
           rebase_path("."),
           "--source_files",
         ] + ohos_arkts_sources

  deps = [ ":flutter_shell_native" ]

