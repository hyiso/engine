    "//flutter/shell/platform/ohos/napi",
    "//flutter/shell/platform/ohos/surface",
    "//flutter/shell/platform/ohos/surface:native_window",
    "//flutter/skia",
    "//flutter/third_party/txt",
    "//flutter/vulkan",
  ]

  public_configs = [ "//flutter:config" ]

  defines = [
    "OHOS_PLATFORM",  # Used in ohos EGL
  ]

  libs = [
    "ace_napi.z",
    "ace_ndk.z",  # Used in ohos XComponentAdapter
    "EGL",
    "GLESv3",
    "native_buffer",
    "native_display_manager",
    "native_image",
    "native_vsync",
    "native_window",
    "qos",
    "rawfile.z",
  ]
}

declare_args() {
  ohos_zip_archive_dir = "ohos-$target_cpu"
  if (flutter_runtime_mode != "debug") {
    ohos_zip_archive_dir += "-$flutter_runtime_mode"
  }
}

